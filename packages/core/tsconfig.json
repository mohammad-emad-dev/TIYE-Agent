{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "strict": true, "esModuleInterop": true, "declaration": true,
    "outDir": "dist", "rootDir": "src", "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
