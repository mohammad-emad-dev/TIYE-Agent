{
  "compilerOptions": {
    "target": "ES2022", "module": "CommonJS", "moduleResolution": "Node",
    "strict": true, "declaration": true, "outDir": "dist", "rootDir": "src",
    "skipLibCheck": true, "noUnusedLocals": true, "noUnusedParameters": true,
    "types": ["node"], "typeRoots": ["../core/node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
}
