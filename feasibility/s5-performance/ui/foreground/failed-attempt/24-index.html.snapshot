<!doctype html><html><head><meta charset="utf-8"><meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'"><link rel="stylesheet" href="xterm.css"><title>TIYE Â· combined S5 workload</title><style>
body{margin:8px;background:#0b1220;color:#dce5f4;font:14px system-ui}header{padding:8px}#layout{display:grid;grid-template-columns:2fr 1fr;gap:8px}#terminals{display:grid;grid-template-columns:1fr 1fr;gap:6px;min-width:0}section{background:#142037;height:210px;overflow:hidden;padding:6px;min-width:0}h2{font-size:12px;margin:0 0 4px}.focus section{display:none}.focus section:first-child{display:block;height:650px}.focus #terminals{grid-template-columns:1fr}aside{background:#142037;padding:8px;min-width:0}#rows{height:480px;overflow:hidden}.row{height:24px;line-height:24px;white-space:nowrap;overflow:hidden}.row:nth-child(even){background:#192943}
</style></head><body><header>TIYE S5 Â· live five-PTY mixed activity + SQLite feed Â· <span id="view">grid</span></header><div id="layout"><main id="terminals"></main><aside><h1 style="font-size:16px">Synthetic event feed</h1><p id="feed-status" role="status">Starting</p><div id="rows" role="region" aria-label="Queried event page"></div></aside></div><script src="renderer.js"></script></body></html>
