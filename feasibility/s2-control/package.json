{
  "name": "tiye-s2-control",
  "version": "0.1.0",
  "private": true,
  "description": "TIYE Agent S2 feasibility fixture: no-model MCP attachment and opt-in native CLI tool invocation probes.",
  "type": "commonjs",
  "scripts": {
    "probe": "node scripts/run-probe.js",
