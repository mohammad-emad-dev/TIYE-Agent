{
  "name": "tiye-s2-control",
  "version": "0.1.0",
  "private": true,
  "description": "TIYE Agent S2 feasibility fixture: no-model MCP attachment and opt-in native CLI tool invocation probes.",
  "type": "commonjs",
  "scripts": {
    "probe": "node scripts/run-probe.js",
    "probe:tool-call": "node scripts/run-tool-probe.js",
    "probe:service-tool-call": "node scripts/run-tool-probe.js --service",
    "probe:terminal-task": "node scripts/run-tool-probe.js --terminal",
    "validate:terminal-task": "node scripts/validate-terminal-task.js",
    "probe:reliability": "node scripts/run-reliability.js",
    "validate:reliability": "node scripts/validate-reliability.js",
    "probe:instructions": "node scripts/run-instructions.js",
    "validate:instructions": "node scripts/validate-instructions.js",
    "probe:briefing": "node scripts/run-briefing.js",
    "validate:briefing": "node scripts/validate-briefing.js",
    "probe:permissions": "node scripts/run-permissions.js",
    "probe:approval-outcomes": "node scripts/run-approval-outcomes.js",
    "probe:permission-controls": "node scripts/run-permission-controls.js",
    "capture:permission-options": "node scripts/capture-permission-options.js",
    "build:permission-capabilities": "node scripts/build-permission-capabilities.js",
    "probe:client-recovery": "node scripts/run-client-recovery.js",
    "probe:active-disconnect": "node scripts/run-active-disconnect.js",
    "probe:stream-cancel": "node scripts/run-stream-cancel.js",
    "probe:acp-stream-cancel": "node scripts/run-acp-stream-cancel.js",
    "probe:acp-faults": "node scripts/run-acp-faults.js",
    "probe:command-cancel": "node scripts/run-command-cancel.js",
    "probe:denied-profiles": "node scripts/run-denied-profiles.js",
    "probe:terminal-approvals": "node scripts/run-terminal-approvals.js",
    "probe:saved-approvals": "node scripts/run-saved-approvals.js",
    "probe:worktree-approvals": "node scripts/run-worktree-approvals.js",
    "probe:strict-ask-preflight": "node scripts/run-strict-ask-preflight.js",
    "probe:strict-ask-monitor": "node scripts/run-strict-ask-monitor.js",
    "probe:strict-ask-active": "node scripts/run-strict-ask-active.js",
    "check": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  }
}
